# ──────────────────────────────────────────────────────────────────────────────
# Amenity Screen Format Detector — environment configuration
# Copy this file to .env and fill in the values before starting the stack.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Full SQLAlchemy connection URL for PostgreSQL.
# Default matches docker-compose.yml service credentials.
DATABASE_URL=postgresql://amenity:amenity@localhost:5432/amenitydb

# ── Security ──────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Change to a long random string in production.
SECRET_KEY=change-me

# ── AWS credentials (local dev only — use IAM role in production) ─────────────
# Fill these in for local development. Leave blank in production and attach
# an IAM role to the EC2/ECS instance instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── AWS Bedrock (Layer 2 AI) ──────────────────────────────────────────────────
# AWS region where Bedrock is available.
BEDROCK_REGION=us-east-1

# Bedrock model ID for no-match AI suggestions.
# Mistral Large 2 (multilingual) is the default.
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct

# Bedrock API key (long-term token).
# Generate in the AWS console under Amazon Bedrock → API access → API keys.
BEDROCK_API_KEY=

# ── AI trigger mode ───────────────────────────────────────────────────────────
# off       — Layer 2 never fires (safe default for local dev)
# on        — Layer 2 fires on every true no-match
# residual  — also fires when a Standard result has unexplained leftover text
AI_TRIGGER_MODE=on

# Auto-apply confidence threshold (0.0–1.0).
# When set, AI suggestions at or above this score are auto-approved.
# Leave blank (default) to require human review for all AI suggestions.
# AI_AUTOAPPLY_CONFIDENCE=

# ── Redis (persistent Bedrock dedup cache) ────────────────────────────────────
# Connection URL for the Redis service.
# Default matches the docker-compose.yml redis service.
REDIS_URL=redis://redis:6379/0

# How many days to keep a cached Bedrock result before expiring it.
# Set lower if you expect AI model outputs to drift over time.
BEDROCK_CACHE_TTL_DAYS=30

# ── Batch processing ──────────────────────────────────────────────────────────
# Hard cap on rows per batch upload (prevents runaway jobs).
MAX_BATCH_ROWS=10000

# How many hours to retain completed job output files on disk.
JOB_TTL_HOURS=24

# ── Detection engine tuning ───────────────────────────────────────────────────
# Minimum token length for Track C prefix matching.
# Tokens shorter than this are skipped so short codes (XD, 3D) do not match
# inside concatenated strings.
TRACK_C_MIN_LEN=4

# Minimum Jaccard similarity score to accept a Track C circuit-name match.
CIRCUIT_MATCH_MIN_JACCARD=0.5

# ── Agentic title matching (Mode B) ──────────────────────────────────────────
# Set to true to replace the deterministic 6-stage pipeline with a Claude Code
# subprocess agent that performs web research + DB search autonomously.
# Keep false (default) for normal Mode A operation.
AGENTIC_TITLE_MATCH_ENABLED=false

# Route Mode B through AWS Bedrock (uses existing AWS_ACCESS_KEY_ID / BEDROCK_REGION creds).
# Set to false only if you want to use a direct Anthropic API key instead.
AGENTIC_USE_BEDROCK=true

# Bedrock cross-region inference profile ARN or Bedrock model ID.
# Must be a model available in your BEDROCK_REGION.
AGENTIC_CLAUDE_MODEL=us.anthropic.claude-sonnet-5

# Hard timeout (seconds) for a single agentic match call.
# Capped by MAX_TIMEOUT_MS (300s) in claude-sandbox/server.js.
AGENTIC_TIMEOUT_SECONDS=150

# TMDB read-only Bearer token — used only when DB results are ambiguous.
# Leave blank to skip TMDB; the agent will note the absence but still produce a result.
AGENTIC_TMDB_READ_TOKEN=

# Max number of in-flight sandbox calls for batch title matching (Mode B).
# celery-agentic-worker's --concurrency flag in docker-compose.yml /
# docker-compose.prod.yml is now driven directly from this variable
# (${AGENTIC_BATCH_MAX_CONCURRENCY:-4}), so the two can no longer drift apart —
# changing this value alone (and, in production, redeploying so
# codedeploy/scripts/start_containers.sh forwards it into .env.compose) moves
# both the semaphore cap and the worker's actual concurrency.
# Currently staged at 4 (Phase 3 of the 2→4→8 concurrency rollout).
AGENTIC_BATCH_MAX_CONCURRENCY=4

# Bedrock-throttle retry/backoff on the sandbox call path. MAX_RETRIES is
# in-process fast-fail retries inside a single sandbox call (runner.py);
# BACKOFF_BASE_SECONDS is that retry's exponential-backoff base.
# CELERY_BACKOFF_SECONDS is a separate, larger base used once a row task
# gives up and asks Celery to redeliver the whole row later (releasing the
# sandbox semaphore slot for the wait) — see title_matching/agentic/limits.py.
AGENTIC_THROTTLE_MAX_RETRIES=1
AGENTIC_THROTTLE_BACKOFF_BASE_SECONDS=2.0
AGENTIC_THROTTLE_CELERY_BACKOFF_SECONDS=30

# S3 bucket for batch upload/output storage — required because backend,
# celery-worker, and celery-agentic-worker are separate containers with no
# shared filesystem; a local /tmp path written by one is invisible to another.
AGENTIC_BATCH_S3_BUCKET=
AGENTIC_BATCH_S3_REGION=us-east-1

# Serper (google.serper.dev) API key — backs the movieweb MCP server's
# web_search/web_fetch tools inside claude-sandbox. Required because Bedrock
# has no built-in WebSearch tool; without this key the agent has no way to
# resolve obscure/foreign-language titles against external sources.
SERPER_API_KEY=

# ── Claude sandbox sidecar ────────────────────────────────────────────────────
# Internal URL of the claude-sandbox Docker service. Override only when running
# the sandbox on a non-default host or port.
CLAUDE_SANDBOX_URL=http://claude-sandbox:3100

# ── Production DB sync (Movie Master) ─────────────────────────────────────────
# Read-only MySQL connection to the production source-of-truth DB
# (fq_movie_master / fq_movie_master_intl), used by the "Sync from Production
# DB" button on the Seed Movie Master page. Leave blank to disable — the sync
# endpoints will return a clear error rather than failing to boot.
PROD_DB_HOST=
PROD_DB_PORT=3306
PROD_DB_DATABASE=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=

# ── External API (singletitle/batchtitle) ─────────────────────────────────────
# EXTERNAL_API_ENABLED must be true for the /api/v1/singletitle,
# /api/v1/batchtitle, and /api/v1/external/jobs/* routes to be mounted at all.
# X_API_KEY is the plaintext key a client sends via the x-api-key header; on
# startup it's hashed (SHA-256) into an ApiKey row (see main.py's
# _seed_env_api_key) — the plaintext itself is never persisted. In production,
# put the plaintext in Secrets Manager and inject it as this env var; nothing
# else about the app needs to change.
EXTERNAL_API_ENABLED=false
X_API_KEY=

# ── Lobby Check API (cinema-lobby marketing-material image extraction) ────────
# See docs/plans/2026-09-01-lobby-check-design.md. LOBBY_CHECK_ENABLED must be
# true for /api/v1/lobby-check and /api/v1/lobby-check/jobs/* to be mounted.
# LOBBY_CHECK_API_KEY works exactly like X_API_KEY above (hashed into its own
# ApiKey row at startup, real value in Secrets Manager in production) but is
# a DEDICATED key, not shared with the external title-match surface, so
# rotating one never affects the other and each gets its own row limit
# (500 images/batch here vs. 10000 CSV rows there).
LOBBY_CHECK_ENABLED=false
LOBBY_CHECK_API_KEY=
# Qwen 3-VL on AWS Bedrock — same model mmvision.py's `qwen` alias resolves
# to. Calls go through the SAME Bedrock credentials as everything else
# (BEDROCK_API_KEY locally / AWS_ACCESS_KEY_ID+AWS_SECRET_ACCESS_KEY in
# production) — no separate Bedrock secret is needed for this feature.
LOBBY_CHECK_MODEL_ID=qwen.qwen3-vl-235b-a22b
# Comma-separated exact hostnames a submitted image_url is allowed to
# target — this server fetches the URL itself, so this is an SSRF boundary,
# not just input validation.
LOBBY_CHECK_ALLOWED_URL_HOSTS=mm-intelligence.s3.amazonaws.com
LOBBY_CHECK_MAX_BATCH_ROWS=500
LOBBY_CHECK_MAX_CONCURRENCY=4
LOBBY_CHECK_TIMEOUT_SECONDS=90
LOBBY_CHECK_ROW_MAX_ATTEMPTS=3
LOBBY_CHECK_JOB_TTL_HOURS=72

# ── Deleted Showtimes Check (SerpApi) ──────────────────────────────────────────
# SerpApi private key(s) backing the deleted-showtime detector. Slot 1
# (SERPAPI_API_KEY) is required; SERPAPI_API_KEY_2 .. _13 are an optional
# rotation pool — when the active key's credits run out, the job fails over
# to the next configured slot instead of aborting. In production these are
# injected from the amenity/serpapi-api-keys Secrets Manager JSON secret
# (keyed "1".."13") via codedeploy/scripts/setup_env.sh.
SERPAPI_API_KEY=
SERPAPI_API_KEY_2=
SERPAPI_API_KEY_3=
SERPAPI_API_KEY_4=
SERPAPI_API_KEY_5=
SERPAPI_API_KEY_6=
SERPAPI_API_KEY_7=
SERPAPI_API_KEY_8=
SERPAPI_API_KEY_9=
SERPAPI_API_KEY_10=
SERPAPI_API_KEY_11=
SERPAPI_API_KEY_12=
SERPAPI_API_KEY_13=
# Hours a key stays skipped after being marked exhausted before rotation
# retries it again (approximates SerpApi's monthly credit reset).
SERPAPI_KEY_COOLDOWN_HOURS=24

# Own dedicated S3 bucket/prefixes for this feature's input/output files —
# independent of AGENTIC_BATCH_S3_BUCKET above.
DELETED_SHOWTIME_S3_BUCKET=
DELETED_SHOWTIME_S3_REGION=us-east-1

# Hard cap on rows per upload (cost guardrail against runaway SerpApi credit
# spend) and how many hours a completed job's output stays downloadable.
DELETED_SHOWTIME_MAX_ROWS=1000
DELETED_SHOWTIME_JOB_TTL_HOURS=720

# Kill the run after N consecutive failed theater batches rather than
# burning SerpApi credits on a run that's clearly not getting usable
# listings back.
DELETED_SHOWTIME_ABORT_AFTER=5
