FROM public.ecr.aws/docker/library/python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/. .
# dqscan (repo-root standalone tool) + its config, so app/tasks/dqscan_task.py
# can shell out to `python -m dqscan.run_daily` from inside this same image
# (see that file's docstring) — build context is the repo root, not backend/,
# specifically so these two lines can reach outside backend/.
COPY dqscan ./dqscan
COPY config.yaml config.prod.yaml ./
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
